DirectoryIndex index.html index.php
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^tools(?:/|$) - [F,L]
    RewriteCond %{HTTP_HOST} ^(?:www\.)?glaonlineadmission\.com$ [NC]
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} ^www\.glaonlineadmission\.com$ [NC]
    RewriteRule ^ https://glaonlineadmission.com%{REQUEST_URI} [R=301,L,NE]
    RewriteRule ^program/(bba|bca|bcom-hons|mba|mca)(?:/index\.html|/?)$ /program/online-$1/ [R=301,L,NE]
    RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html(?:[?\s]) [NC]
    RewriteRule ^(.*)index\.html$ /$1 [R=301,L,NE]
</IfModule>

<FilesMatch "(^\.|\.ini$|\.sql$|\.py$|\.pyc$|\.md$|^requirements\.txt$)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    <FilesMatch "\.(?:json|xml|php)$">
        Header set X-Robots-Tag "noindex"
    </FilesMatch>
</IfModule>
